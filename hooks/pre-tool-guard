#!/usr/bin/env bash
# PreToolUse Guard for oh-my-beom plugin
# 1. 보호 브랜치 커밋 차단
# 2. 보호 브랜치 push 차단 (force push 포함)
# 3. config/config.json 개인정보 커밋 차단

set -uo pipefail

INPUT=$(cat /dev/stdin 2>/dev/null || echo '{}')

# ─── tool_input.command에서 git 명령만 추출 ───
# echo "git push ..." 등 문자열 내부의 git 명령은 무시하고,
# 실제 실행되는 git 명령(첫 단어가 git인 서브커맨드)만 추출한다.
CMD=$(echo "$INPUT" | python3 -c "
import json, sys, re
try:
    data = json.load(sys.stdin)
    full_cmd = data.get('tool_input', {}).get('command', '')
    # &&, ;, | 로 분리된 서브커맨드 중 'git '으로 시작하는 것만 추출
    parts = re.split(r'[;&|]+', full_cmd)
    git_cmds = [p.strip() for p in parts if re.match(r'\s*git\s', p.strip())]
    # 모든 git 명령을 줄바꿈으로 연결하여 반환 (각각 검사 대상)
    print('\n'.join(git_cmds) if git_cmds else '')
except:
    print('')
" 2>/dev/null || echo "")

# ─── 위험 시스템 명령 차단 (git 이외) ───
FULL_CMD=$(echo "$INPUT" | python3 -c "
import json, sys
try:
    data = json.load(sys.stdin)
    print(data.get('tool_input', {}).get('command', ''))
except: print('')
" 2>/dev/null || echo "")

deny() {
  local reason="$1"
  cat <<EOF
{
  "hookSpecificOutput": {
    "hookEventName": "PreToolUse",
    "permissionDecision": "deny",
    "permissionDecisionReason": "${reason}"
  }
}
EOF
  exit 0
}

ask() {
  local reason="$1"
  cat <<EOF
{
  "hookSpecificOutput": {
    "hookEventName": "PreToolUse",
    "permissionDecision": "ask",
    "permissionDecisionReason": "${reason}"
  }
}
EOF
  exit 0
}

# rm -rf / 또는 ~ 차단
if echo "$FULL_CMD" | grep -qE 'rm\s+(-rf|-fr)\s+(/|~|\$HOME)' 2>/dev/null; then
  deny "위험 명령: rm -rf로 루트/홈 디렉토리 삭제 시도 감지"
fi

# chmod 777 차단
if echo "$FULL_CMD" | grep -qE 'chmod\s+777' 2>/dev/null; then
  deny "위험 명령: chmod 777은 보안상 금지"
fi

# git 명령이 아니면 통과
if [ -z "$CMD" ]; then
  echo '{"continue": true}'
  exit 0
fi

# 명령이 대상 repo를 지정했으면(git -C / cd) 훅의 cwd가 아니라 그 repo의 브랜치를 본다.
# cwd만 보면 다른 repo에 커밋할 때도 cwd 브랜치로 오판한다.
get_branch() {
  local branch target
  target=$(echo "$CMD" | sed -n 's/.*git[[:space:]]\{1,\}-C[[:space:]]\{1,\}\([^[:space:]"]\{1,\}\).*/\1/p' 2>/dev/null || echo "")
  if [ -z "$target" ]; then
    target=$(echo "$FULL_CMD" | grep -oE '(^|[;&|][[:space:]]*)cd[[:space:]]+[^;&|)]+' | head -1 \
      | sed -E 's/.*cd[[:space:]]+//; s/["'"'"']//g' | awk '{print $1}' 2>/dev/null || echo "")
  fi
  if [ -n "$target" ] && [ -d "$target" ]; then
    branch=$(git -C "$target" symbolic-ref --short HEAD 2>/dev/null || echo "")
  fi
  if [ -z "$branch" ]; then
    branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
  fi
  echo "$branch"
}

# 대상 repo 경로 해석 (git -C 우선, 없으면 cd 대상, 둘 다 없으면 cwd)
resolve_repo_dir() {
  local target
  target=$(echo "$CMD" | sed -n 's/.*git[[:space:]]\{1,\}-C[[:space:]]\{1,\}\([^[:space:]"]\{1,\}\).*/\1/p' 2>/dev/null || echo "")
  if [ -z "$target" ]; then
    target=$(echo "$FULL_CMD" | grep -oE '(^|[;&|][[:space:]]*)cd[[:space:]]+[^;&|)]+' | head -1 \
      | sed -E 's/.*cd[[:space:]]+//; s/["'"'"']//g' | awk '{print $1}' 2>/dev/null || echo "")
  fi
  if [ -n "$target" ] && [ -d "$target" ]; then
    echo "$target"
  else
    echo "."
  fi
}

# hh-command-center는 보호 브랜치 검사 면제 — 지식 저장소라 master 직접 커밋·push가 규칙이며
# 자체 branch-guard.sh를 따로 둔다. 분리 전략(feat 브랜치 → MR)은 MSA 코드 repo 대상이다.
if git -C "$(resolve_repo_dir)" remote get-url origin 2>/dev/null | grep -q 'hh-command-center'; then
  echo '{"continue": true}'
  exit 0
fi

PROTECTED_RE="^(develop|main|master|test|dev)$"

# CMD는 줄바꿈으로 구분된 여러 git 명령일 수 있음 (체인 명령)
# 각 git 명령을 개별 검사한다
while IFS= read -r GIT_CMD; do
  [ -z "$GIT_CMD" ] && continue

  case "$GIT_CMD" in
    # ─── git push 보호 ───
    git\ push*)
      # force push 차단
      case "$GIT_CMD" in
        *--force*|*" -f "*)
          deny "git push --force는 금지되어 있습니다."
          ;;
      esac

      # 원격 브랜치 삭제 처리 (--delete | -d | refspec ':branch')
      # 다른 브랜치를 삭제하는 작업은 현재 체크아웃된 보호 브랜치에 영향이 없으므로
      # 보호 브랜치 자체를 삭제하려는 경우만 차단하고 그 외는 허용한다.
      IS_DELETE=0
      DEL_TARGET=""
      case "$GIT_CMD" in
        *" --delete "*)
          IS_DELETE=1
          DEL_TARGET=$(printf '%s' "$GIT_CMD" | sed -E 's/.*--delete[[:space:]]+([a-zA-Z0-9._/-]+).*/\1/')
          ;;
        *" -d "*)
          IS_DELETE=1
          DEL_TARGET=$(printf '%s' "$GIT_CMD" | sed -E 's/.* -d[[:space:]]+([a-zA-Z0-9._/-]+).*/\1/')
          ;;
      esac
      if [ "$IS_DELETE" = "0" ] && printf '%s' "$GIT_CMD" | grep -qE '(^|[[:space:]])origin[[:space:]]+:[a-zA-Z0-9._/-]+' 2>/dev/null; then
        IS_DELETE=1
        DEL_TARGET=$(printf '%s' "$GIT_CMD" | sed -E 's/.*[[:space:]]origin[[:space:]]+:([a-zA-Z0-9._/-]+).*/\1/')
      fi

      if [ "$IS_DELETE" = "1" ]; then
        case "$DEL_TARGET" in
          test)
            ask "보호 브랜치 test 원격 삭제 시도입니다. 정말 진행할까요?"
            ;;
          main|master|develop|dev)
            deny "보호 브랜치 ${DEL_TARGET}는 삭제할 수 없습니다."
            ;;
        esac
        # 보호 브랜치가 아닌 원격 브랜치 삭제는 허용 — 이후 push 검사 건너뜀
        continue
      fi

      # 보호 브랜치로의 직접 push: test는 ask, 나머지는 deny
      case "$GIT_CMD" in
        *"origin test"*|*"origin/test"*|*":test"*|*"HEAD:test"*)
          ask "test 브랜치로 직접 push 시도입니다. 정말 진행할까요?"
          ;;
      esac
      for b in main master develop dev; do
        case "$GIT_CMD" in
          *"origin ${b}"*|*"origin/${b}"*|*":${b}"*|*"HEAD:${b}"*)
            deny "Protected branch: ${b} 브랜치로 직접 push할 수 없습니다."
            ;;
        esac
      done

      # 현재 보호 브랜치에서 타겟 미지정 bare push: test는 ask, 나머지는 deny
      CURRENT=$(get_branch)
      if [[ -n "$CURRENT" && "$CURRENT" =~ $PROTECTED_RE ]]; then
        if echo "$GIT_CMD" | grep -qE 'origin[[:space:]]+[a-zA-Z]' 2>/dev/null; then
          :
        elif [ "$CURRENT" = "test" ]; then
          ask "현재 test 브랜치에서 push 시도입니다. 정말 진행할까요?"
        else
          deny "Protected branch: ${CURRENT} 브랜치에서 직접 push할 수 없습니다. 작업 브랜치로 전환하세요."
        fi
      fi
      ;;

    # ─── git commit 보호 ───
    git\ commit*)
      # 보호 브랜치 커밋 차단
      CURRENT=$(get_branch)
      if [[ -n "$CURRENT" && "$CURRENT" =~ $PROTECTED_RE ]]; then
        deny "Protected branch: ${CURRENT} 브랜치에서는 직접 커밋할 수 없습니다. 작업 브랜치를 먼저 생성하세요."
      fi

      # config/config.json 개인정보 커밋 차단
      if git diff --cached --name-only 2>/dev/null | grep -q "config/config.json"; then
        HAS_CREDS=$(git show :config/config.json 2>/dev/null | python3 -c "
import json, sys
try:
    data = json.load(sys.stdin)
    creds = data.get('webTest', {}).get('credentials', {})
    if creds and any(v for v in creds.values() if isinstance(v, dict) and (v.get('id') or v.get('pw') or v.get('password'))):
        print('yes')
    else:
        print('no')
except:
    print('no')
" 2>/dev/null || echo "no")
        if [ "$HAS_CREDS" = "yes" ]; then
          deny "config/config.json에 개인정보(webTest.credentials)가 포함되어 있습니다. credentials를 비운 후 다시 커밋하세요."
        fi
      fi

      # [WEB-TEST-REQUIRED] 웹 테스트 미실행 차단
      if [ -f ".dev/web-test-required" ] && [ ! -f ".dev/web-test-passed" ]; then
        deny "[WEB-TEST-REQUIRED] qa-manager가 웹 테스트를 요구했지만 아직 실행되지 않았습니다. web-test 스킬을 먼저 실행하세요."
      fi
      ;;
  esac
done <<< "$CMD"

echo '{"continue": true}'
exit 0
